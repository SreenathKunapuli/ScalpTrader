# .env.example — copy to .env and fill in real values before running.
# The engine and API both load this file via pydantic-settings (env_file=".env").
# Field names below match Settings fields in engine/scalpengine/config/settings.py exactly.
#
# NEVER commit a .env with real credentials. This file contains placeholders only.

# ---------------------------------------------------------------------------
# Trading mode
# ---------------------------------------------------------------------------
# "paper" (default, structurally enforced) or "live" (Phase 4 only).
TRADING_MODE=paper

# ---------------------------------------------------------------------------
# Alpaca paper-trading credentials
# ---------------------------------------------------------------------------
# Get from https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ---------------------------------------------------------------------------
# Alpaca live credentials (Phase 4 only — leave blank in paper mode)
# ---------------------------------------------------------------------------
# Leaving these blank makes live trading structurally impossible.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Hard equity cap for live mode (USD float, e.g. 5000.0); required if live.
MAX_LIVE_EQUITY_USD=

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Postgres connection string (Neon / Supabase / any hosted PG).
# When set, both the engine and the API use Postgres.
# When blank, the engine falls back to SQLite at SQLITE_PATH.
DATABASE_URL=postgresql://user:password@host.neon.tech/scalptrader?sslmode=require

# SQLite fallback (ignored when DATABASE_URL is set).
DB_BACKEND=sqlite
SQLITE_PATH=scalpengine.db

# Redis pub-sub (optional — leave blank to disable; polling fallback is used).
REDIS_URL=

# ---------------------------------------------------------------------------
# API auth
# ---------------------------------------------------------------------------
# Password the owner uses on the dashboard login page.
APP_PASSWORD=change-me-before-running

# HS256 signing secret for JWT tokens.  Generate with: openssl rand -hex 32
JWT_SECRET=change-me-before-running

# Token lifetime in hours (default 24).
JWT_EXPIRY_HOURS=24

# Comma-separated CORS origins the API will accept (no trailing slash).
# In production: set to your Vercel domain.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Engine tuning (all have safe defaults; override only if needed)
# ---------------------------------------------------------------------------
# Scalp profile: off | small | large (off = scanner only, no orders placed).
SCALP_PROFILE=off

# Risk tier: low | medium | high
RISK_TIER=medium

# How often the engine samples 1-minute bars (seconds).
BAR_INTERVAL_S=60

# How often signal models evaluate (seconds).
SIGNAL_BAR_INTERVAL_S=300

# Days of history to warm up on startup.
HISTORY_WARMUP_DAYS=30

# Seconds of data staleness before the engine pauses trading.
STALENESS_PAUSE_S=60

# Seconds of data staleness before the engine kills itself.
STALENESS_KILL_S=180

# Consecutive broker errors before kill.
BROKER_ERROR_KILL_COUNT=5

# Window (seconds) for the broker-error counter.
BROKER_ERROR_KILL_WINDOW_S=60

# How often the engine writes a heartbeat row (seconds).
HEARTBEAT_INTERVAL_S=10

# Directory where trained signal models are stored.
MODELS_DIR=models
